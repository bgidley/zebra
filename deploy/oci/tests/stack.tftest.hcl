# terraform test for the Zebra OCI stack (#279). The oci provider is mocked, so no
# credentials or API calls are needed. Run via scripts/oci_iac_check.sh.

mock_provider "oci" {}

variables {
  tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaatest"
  compartment_ocid = "ocid1.tenancy.oc1..aaaaaaaatest"
}

run "always_free_by_default" {
  command = plan

  assert {
    condition     = oci_core_instance.zebra.shape == "VM.Standard.A1.Flex"
    error_message = "Instance must use the Always Free Arm A1 shape."
  }
  assert {
    condition     = oci_core_instance.zebra.shape_config[0].ocpus == 2 && oci_core_instance.zebra.shape_config[0].memory_in_gbs == 12
    error_message = "Instance must be 2 OCPU / 12 GB."
  }
  assert {
    condition     = oci_core_instance.zebra.source_details[0].boot_volume_size_in_gbs <= 200
    error_message = "Boot volume must stay within the free 200 GB."
  }
  assert {
    condition     = oci_core_instance.zebra.create_vnic_details[0].assign_public_ip == "true"
    error_message = "Instance must get an ephemeral public IP."
  }
  assert {
    condition     = oci_database_autonomous_database.zebra.is_free_tier == true
    error_message = "Autonomous Database must be the Always Free instance."
  }
  assert {
    condition     = oci_database_autonomous_database.zebra.is_mtls_connection_required == true
    error_message = "Autonomous Database must require mTLS (it has a public endpoint)."
  }
  assert {
    condition     = oci_kms_vault.zebra.vault_type == "DEFAULT"
    error_message = "Vault must be the free DEFAULT vault."
  }
  assert {
    condition     = oci_kms_key.zebra.protection_mode == "SOFTWARE"
    error_message = "Key must be software-protected (HSM keys bill)."
  }
  assert {
    condition     = oci_vault_secret.adb_admin.enable_auto_generation == true
    error_message = "The database admin password must be generated by Vault, not passed in."
  }
  assert {
    condition     = length(oci_core_security_list.zebra.ingress_security_rules) == 1
    error_message = "Only one ingress rule (HTTPS) is allowed."
  }
  assert {
    condition = alltrue([
      for r in oci_core_security_list.zebra.ingress_security_rules :
      r.protocol == "6" && r.tcp_options[0].min == 443 && r.tcp_options[0].max == 443
    ])
    error_message = "The only open port must be TCP 443."
  }
  assert {
    condition     = try(oci_core_instance.zebra.metadata["ssh_authorized_keys"], null) == null
    error_message = "No SSH key is installed unless one is given."
  }
  assert {
    condition     = var.region == "uk-london-1"
    error_message = "Default region must be London (uk-london-1)."
  }
}

run "ssh_key_goes_in_metadata_only" {
  command = plan

  variables {
    ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyOnlyForTests test@zebra"
  }

  assert {
    condition     = oci_core_instance.zebra.metadata["ssh_authorized_keys"] == var.ssh_public_key
    error_message = "The SSH key must be installed for opc."
  }
  assert {
    condition     = length(oci_core_security_list.zebra.ingress_security_rules) == 1
    error_message = "An SSH key must not open port 22."
  }
}

run "domain_sets_url" {
  command = plan

  variables {
    domain = "zebra.example.com"
  }

  assert {
    condition     = output.zebra_url == "https://zebra.example.com/"
    error_message = "A domain must become the Zebra URL."
  }
}

run "rejects_unknown_release_channel" {
  command = plan

  variables {
    release_channel = "nightly"
  }

  expect_failures = [var.release_channel]
}

run "rejects_malformed_ssh_key" {
  command = plan

  variables {
    ssh_public_key = "not a key"
  }

  expect_failures = [var.ssh_public_key]
}
