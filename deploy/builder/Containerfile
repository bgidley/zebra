# Zebra build sandbox (#98, #172): headless Claude Code with git, Python and uv.
#
# Built by scripts/deploy-podman.sh as localhost/zebra-builder-sandbox:prod and run by the host
# builder (scripts/zebra_builder.py) once per build, as the host user via --userns=keep-id.
# It holds no credentials: the builder passes only CLAUDE_CODE_OAUTH_TOKEN at run time.
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates python3 curl procps \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /usr/local/bin/

ARG CLAUDE_CODE_VERSION=2.1.304
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && npm cache clean --force

# uv-managed Pythons land somewhere every uid can write (the sandbox runs as the host uid).
ENV UV_PYTHON_INSTALL_DIR=/tmp/uv-python \
    UV_TOOL_BIN_DIR=/tmp/uv-bin

COPY sandbox-run.sh /usr/local/bin/sandbox-run
COPY sandbox-probe.sh /usr/local/bin/sandbox-probe
RUN chmod 755 /usr/local/bin/sandbox-run /usr/local/bin/sandbox-probe

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/sandbox-run"]
