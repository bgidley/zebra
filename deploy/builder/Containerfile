# Zebra build sandbox (#98, #172, #251): headless Claude Code with git, Python, uv, and the
# delivery tools glab, gh and openspec.
#
# Built by scripts/deploy-podman.sh as localhost/zebra-builder-sandbox:prod and run by the host
# builder (scripts/zebra_builder.py) once per build, as the host user via --userns=keep-id.
# It holds no credentials: the builder passes CLAUDE_CODE_OAUTH_TOKEN, and a delivery stage's
# own GITLAB_TOKEN / GH_TOKEN, at run time.
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates python3 curl procps \
 && rm -rf /var/lib/apt/lists/*

# Distrust the eMudhra/emSign roots (bad CA keys, Oct 2026) until Debian ships the fix.
RUN sed -i -E 's|^(mozilla/emSign_)|!\1|' /etc/ca-certificates.conf \
 && update-ca-certificates --fresh >/dev/null \
 && ! ls /etc/ssl/certs | grep -qi emsign

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /usr/local/bin/

ARG CLAUDE_CODE_VERSION=2.1.304
ARG OPENSPEC_VERSION=1.13.2
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "@fission-ai/openspec@${OPENSPEC_VERSION}" \
 && npm cache clean --force

# glab and gh for delivery stages (#251), pinned and checked against the release checksums.
ARG GLAB_VERSION=1.119.0
ARG GLAB_SHA256_ARM64=8540c4afbe63c4da023c15bfce15f2f1ef9cc1afe4a6fd6812c426b9eeab073b
ARG GLAB_SHA256_AMD64=4d83375d202ffa634eaf627fd9272b610fa599f20f5b711f55d770583eca2b84
ARG GH_VERSION=2.103.2
ARG GH_SHA256_ARM64=4c3e99a50bd8b181a3fe9d69b25dd978bac768148d88f01507c6b4d1ef61a443
ARG GH_SHA256_AMD64=62ccf747115ddc61237efffdde66a3c8f70ba249433dc64f70801089b59c59c8
RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      arm64) glab_sum="$GLAB_SHA256_ARM64"; gh_sum="$GH_SHA256_ARM64" ;; \
      amd64) glab_sum="$GLAB_SHA256_AMD64"; gh_sum="$GH_SHA256_AMD64" ;; \
      *) echo "unsupported arch $arch" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    curl -fsSL -o glab.tgz "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_${arch}.tar.gz"; \
    echo "$glab_sum  glab.tgz" | sha256sum -c -; \
    tar -xzf glab.tgz bin/glab && install -m 755 bin/glab /usr/local/bin/glab; \
    curl -fsSL -o gh.tgz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz"; \
    echo "$gh_sum  gh.tgz" | sha256sum -c -; \
    tar -xzf gh.tgz "gh_${GH_VERSION}_linux_${arch}/bin/gh" \
      && install -m 755 "gh_${GH_VERSION}_linux_${arch}/bin/gh" /usr/local/bin/gh; \
    rm -rf /tmp/glab.tgz /tmp/gh.tgz /tmp/bin "/tmp/gh_${GH_VERSION}_linux_${arch}"; \
    glab version; gh --version | head -1; openspec --version

# uv-managed Pythons land somewhere every uid can write (the sandbox runs as the host uid).
# The pinned Claude Code must not update itself or phone home beyond the API.
ENV UV_PYTHON_INSTALL_DIR=/tmp/uv-python \
    UV_TOOL_BIN_DIR=/tmp/uv-bin \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    GLAB_CHECK_UPDATE=false \
    GH_NO_UPDATE_NOTIFIER=1 \
    OPENSPEC_TELEMETRY=0

COPY sandbox-run.sh /usr/local/bin/sandbox-run
COPY sandbox-probe.sh /usr/local/bin/sandbox-probe
RUN chmod 755 /usr/local/bin/sandbox-run /usr/local/bin/sandbox-probe

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/sandbox-run"]
