# Non-secret prod settings. bootstrap-host.sh copies this to ~/.config/zebra/site.env
# (if absent); scripts/deploy-podman.sh appends it to the generated prod.env.
# Secrets do NOT go here — they come from GitLab CI variables.
# podman --env-file format: KEY=value, no quotes, no shell expansion.

# Passkeys are bound to this RP ID — keep the Tailscale hostname `zebra-oke` so
# passkeys registered under OKE keep working.
WEBAUTHN_RP_ID=zebra-oke.tailf1e473.ts.net
WEBAUTHN_ORIGIN=https://zebra-oke.tailf1e473.ts.net
CSRF_TRUSTED_ORIGINS=https://zebra-oke.tailf1e473.ts.net
SESSION_COOKIE_SECURE=1

ZEBRA_DAILY_BUDGET_USD=50.00
ZEBRA_LLM_MODEL=opus
