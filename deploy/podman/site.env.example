# Non-secret prod settings. bootstrap-host.sh copies this to ~/.config/zebra/site.env
# (if absent); scripts/deploy-podman.sh appends it to the generated prod.env.
# Secrets do NOT go here — they come from GitLab CI variables.
# podman --env-file format: KEY=value, no quotes, no shell expansion.

# Public hostname served by the Cloudflare Tunnel (deploy/podman/setup-tunnel.sh).
# Passkeys are bound to this RP ID — changing it invalidates every registered passkey.
WEBAUTHN_RP_ID=zebra.gidley.co.uk
WEBAUTHN_ORIGIN=https://zebra.gidley.co.uk
CSRF_TRUSTED_ORIGINS=https://zebra.gidley.co.uk
SESSION_COOKIE_SECURE=1

ZEBRA_DAILY_BUDGET_USD=50.00
ZEBRA_LLM_MODEL=opus

# Outbound email for the notify_email action (F65) via OCI Email Delivery.
# The sender must be an OCI approved sender on the zebra.gidley.co.uk email domain.
# ZEBRA_SMTP_USERNAME / ZEBRA_SMTP_PASSWORD are secrets (GitLab CI variables).
ZEBRA_SMTP_HOST=smtp.email.uk-london-1.oci.oraclecloud.com
ZEBRA_SMTP_PORT=587
ZEBRA_SMTP_SECURITY=starttls
ZEBRA_SMTP_FROM=zebra@zebra.gidley.co.uk
# Default recipient(s), comma-separated.
ZEBRA_NOTIFY_EMAIL_TO=
